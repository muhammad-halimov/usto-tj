###> google ###
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
GOOGLE_CERTS_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_REDIRECT_URI=
GOOGLE_ACCOUNT_URI=https://accounts.google.com
GOOGLE_ACCOUNT_ADDITIONAL_INFO_URI=https://people.googleapis.com/v1/people/me
###< google ###

###> instagram ###
OUATH_INSTAGRAM_CLIENT_SECRET=
OUATH_INSTAGRAM_CLIENT_ID=
INSTAGRAM_AUTH_URI=https://www.instagram.com/oauth/authorize
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_TOKEN_URI=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_URI=https://graph.instagram.com/me
###< instagram ###

###> facebook ###
OUATH_FACEBOOK_CLIENT_SECRET=
OUATH_FACEBOOK_CLIENT_ID=
FACEBOOK_AUTH_URI=https://www.facebook.com/v24.0/dialog/oauth
FACEBOOK_REDIRECT_URI=
FACEBOOK_TOKEN_URI=https://graph.facebook.com/v24.0/oauth/access_token
FACEBOOK_GRAPH_URI=https://graph.facebook.com/me
###< facebook ###

###> vk ###
OUATH_VK_CLIENT_SECRET=
OUATH_VK_CLIENT_ID=
###< vk ###

###> telegram ###
# У Telegram Login Widget нет пары client_id/client_secret как у остальных
# провайдеров выше — есть только токен бота (см. @BotFather), который
# одновременно и идентифицирует бота, и служит секретом для HMAC-проверки
# подписи виджета (TelegramHashVerifierService). ВАЖНО: это токен именно
# БОТА ЛОГИНА (у нас — ustoyobtj_auth_bot), а НЕ TELEGRAM_BOT_TOKEN из
# основного .env — та переменная принадлежит отдельному боту техподдержки
# (ustoyobtj_tech_support_bot) и используется только для его уведомлений.
TELEGRAM_AUTH_BOT_TOKEN=
###< telegram ###
